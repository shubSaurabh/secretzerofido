[Xx]64/
[Xx]86/
[Bb]uild/
[Bb]in/
[Oo]bj/
[Ll]og/

# Python (for any Python files in tracked directories)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
