# ============================================
# Repository Scope: Only track CredentialProvider and securitaascpinstaller
# ============================================

# Explicitly ignore directories we don't want to track
AuthServer/
examples/
QRScanner/

# Ignore all root-level files except specific ones
/*
!/.gitignore
!/README.md
!/LICENSE
!/CredentialProvider/
!/securitaascpinstaller/

# ============================================
# Build artifacts (applies to tracked directories)
# ============================================
*.obj
*.pdb
*.ilk
*.exe
*.dll
*.lib
*.exp
*.suo
*.user
*.sdf
*.opensdf
*.aps
*.ncb
*.opendb
*.cachefile
*.VC.db
*.VC.VC.opendb

